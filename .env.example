# Copy to .env and adjust. Values below are local-only placeholders, not secrets.

# PostgreSQL
POSTGRES_USER=sgp
POSTGRES_PASSWORD=change_me_local
POSTGRES_DB=sgp_kotoduo
POSTGRES_PORT=5432
DATABASE_URL=postgres://sgp:change_me_local@localhost:5432/sgp_kotoduo

# MongoDB (mongo:8 refuses to start on Linux kernel >= 6.19; 9.0 exposes the same API)
MONGO_IMAGE=mongo:9.0
MONGO_PORT=27017
MONGO_URL=mongodb://localhost:27017/sgp_docs

# API
API_PORT=3000
CORS_ORIGIN=http://localhost:5173
# Development accepts this placeholder with a warning. The compose stack runs the
# API with NODE_ENV=production and refuses it: generate one with openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_string
# Proxy hops trusted for the client IP. 0 for npm run dev; the compose sets 1 (nginx).
TRUST_PROXY=0
# PostgreSQL role the API switches to after login (least privilege). Empty for
# npm run dev and the integration tests (they clean up as the owner); the compose sets sgp_app.
DB_ROL=

# Web (compose stack, nginx): http://localhost:8080
WEB_PORT=8080
