########## 4) Privilegios con el rol sgp_app (psql, transacciones con ROLLBACK) ##########
== Privilegios del rol sgp_app (R7, R8). Cada intento en su propia transacción con ROLLBACK: no cambia datos ni esquema ==
 conectado_como | es_superusuario 
----------------+-----------------
 sgp            | t
(1 row)

-- 1) UPDATE sobre movimiento_insumo como sgp_app
BEGIN
SET
psql:/tmp/cp32-sgpapp.sql:4: ERROR:  permission denied for table movimiento_insumo
ROLLBACK
-- 2) DELETE sobre outbox_evento como sgp_app
BEGIN
SET
psql:/tmp/cp32-sgpapp.sql:6: ERROR:  permission denied for table outbox_evento
ROLLBACK
-- 3) CREATE TABLE en el esquema sgp como sgp_app
BEGIN
SET
psql:/tmp/cp32-sgpapp.sql:8: ERROR:  permission denied for schema sgp
LINE 1: CREATE TABLE sgp.xss_cp32_intento (id int);
                     ^
ROLLBACK
-- 3b) CREATE TABLE en public como sgp_app
BEGIN
SET
psql:/tmp/cp32-sgpapp.sql:10: ERROR:  permission denied for schema public
LINE 1: CREATE TABLE public.xss_cp32_intento (id int);
                     ^
ROLLBACK
-- Control: SELECT permitido como sgp_app
BEGIN
SET
 movimientos_visibles 
----------------------
                   14
(1 row)

ROLLBACK
