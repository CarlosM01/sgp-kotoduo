{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "@testing-library/jest-dom/vitest"
    ],
    "paths": {
      "@dominio/*": [
        "../api/src/dominio/*"
      ],
      "@api/*": [
        "../api/src/*"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "e2e",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
